+/// Browser frontend for the real Studio application. The host owns scheduling,
+/// input, audio messages and persistence; rendering and interaction stay in App.
+#[cfg(target_arch = "wasm32")]
+pub struct BrowserStudio {
+    app: App,
+    analyzer: rustel_runtime::ui_analysis::UiAudioAnalyzer,
+    cursor: Option<(u16, u16)>,
+}
+#[cfg(target_arch = "wasm32")]
+impl BrowserStudio {
+    pub fn new(source: &str, state: Option<&str>) -> Result<Self, String> {
+        let mut options = StudioOptions::new("browser");
+        options.memory_clipboard = false;
+        options.default_samples = false;
+        let scenes = match state.and_then(SceneSet::from_browser_state) {
+            Some(scenes) => scenes,
+            None => SceneSet::from_browser_source(source).map_err(|e| e.to_string())?,
+        };
+        let worker = StudioWorker::browser().map_err(|e| e.message)?;
+        let mut app = App::new(options, Theme::built_in_default(), scenes, worker)
+            .map_err(|e| e.to_string())?;
+        app.devices
+            .pin(crate::devices::DeviceInventory::no_hardware());
+        app.adopt_terminal(TerminalFeatures {
+            name: "Browser".into(),
+            keyboard: true,
+            truecolor: true,
+            symbols: true,
+            cell_pixels: Some((8, 18)),
+            ..Default::default()
+        });
+        app.capabilities = KeyboardCapabilities::enhanced();
+        Ok(Self {
+            app,
+            analyzer: rustel_runtime::ui_analysis::UiAudioAnalyzer::new(),
+            cursor: None,
+        })
+    }
+    pub fn play(&mut self) -> Result<(), String> {
+        self.app
+            .dispatch_bind_action(BindAction::Evaluate, false)
+            .map(|_| ())
+            .map_err(|e| e.to_string())
+    }
+    pub fn stop(&mut self) -> Result<(), String> {
+        self.app
+            .dispatch_bind_action(BindAction::Stop, false)
+            .map(|_| ())
+            .map_err(|e| e.to_string())
+    }
+    pub fn zen(&self) -> bool {
+        self.app.ui_settings.zen
+    }
+    pub fn toggle_zen(&mut self) {
+        self.app.toggle_zen();
+    }
+    pub fn source(&self) -> String {
+        self.app.editor().source()
+    }
+    pub fn state(&self) -> String {
+        self.app.scenes.browser_state()
+    }
+    pub fn cursor(&self) -> Option<(u16, u16)> {
+        self.cursor
+    }
+    pub fn clipboard(&mut self) -> String {
+        PlatformClipboard::browser_text()
+    }
+    pub fn clipboard_status(&mut self, message: &str) {
+        self.app.clear_error(ErrorOwner::Editor);
+        self.app.status = message.into();
+        self.app.dirty_frame = true;
+    }
+    pub fn gain(&self) -> f32 {
+        self.app.worker.master().gain()
+    }
+    pub fn event(&mut self, event: crossterm::event::Event) -> Result<(), String> {
+        self.app
+            .handle_terminal_event(event)
+            .map_err(|e| e.to_string())
+    }
+    pub fn commands(&mut self) -> String {
+        self.app.flush_pending_evaluation();
+        self.app.flush_pending_sliders();
+        let mut commands = self.app.worker.browser_commands();
+        if PlatformClipboard::take_browser_read() {
+            commands.push(serde_json::json!({"type":"clipboard-read"}));
+        }
+        if let Some(text) = PlatformClipboard::take_browser_write() {
+            commands.push(serde_json::json!({"type":"clipboard-write","text":text}));
+        }
+        serde_json::to_string(&commands).unwrap_or_else(|_| "[]".into())
+    }
+    pub fn evaluated(
+        &mut self,
+        request: u64,
+        revision: u64,
+        source: &str,
+        generation: u64,
+        error: Option<String>,
+    ) {
+        self.app
+            .worker
+            .browser_evaluated(request, revision, source, generation, error);
+        self.app.drain_engine();
+    }
+    pub fn transport(&mut self, playing: bool, generation: u64, cycle: f64, cps: f64) {
+        self.app.worker.browser_snapshot(
+            playing,
+            generation,
+            cycle,
+            cps,
+            self.app.evaluated_source.as_deref().unwrap_or(""),
+        );
+        self.app.drain_engine();
+    }
+    pub fn events(
+        &mut self,
+        json: &str,
+        generation: u64,
+        time: f64,
+        cps: f64,
+    ) -> Result<(), String> {
+        use rustel_runtime::ui_events::{UiEventBatch, UiScheduledEvent};
+        let values: Vec<serde_json::Value> =
+            serde_json::from_str(json).map_err(|e| e.to_string())?;
+        let rational = |n: f64| format!("{}/1000000", (n * 1_000_000.0).round() as i64);
+        let events = values
+            .into_iter()
+            .take(2048)
+            .map(|v| {
+                let begin = v["cycle"].as_f64().unwrap_or(0.0);
+                let duration = v["duration"].as_f64().unwrap_or(0.0);
+                UiScheduledEvent {
+                    onset_id: v["id"].as_u64().unwrap_or(0),
+                    generation,
+                    whole_begin: rational(begin),
+                    whole_end: rational(begin + duration),
+                    part_begin: rational(begin),
+                    part_end: rational(begin + duration),
+                    target_time: begin / cps.max(0.0001),
+                    duration_seconds: duration / cps.max(0.0001),
+                    value: v["sound"].as_str().map(str::to_owned),
+                    color: None,
+                    label: None,
+                    active_label: None,
+                    scale: None,
+                    frequency_hz: v["pitch"]
+                        .as_f64()
+                        .map(|p| (440.0 * 2_f64.powf((p - 69.0) / 12.0)) as f32),
+                    gain: v["gain"].as_f64().map(|g| g as f32),
+                    sample: None,
+                    lane: v["lane"]
+                        .as_str()
+                        .and_then(|s| s.trim_start_matches('#').parse().ok()),
+                    sound: v["sound"].as_str().map(str::to_owned),
+                    ui_visuals: v["ui_visuals"]
+                        .as_str()
+                        .and_then(|s| s.parse().ok())
+                        .or_else(|| v["ui_visuals"].as_u64())
+                        .unwrap_or(0),
+                    context: serde_json::from_value(v["context"].clone()).unwrap_or_default(),
+                }
+            })
+            .collect();
+        let revision = source_revision(self.app.evaluated_source.as_deref().unwrap_or(""));
+        let batch = UiEventBatch::new(time, time * cps, cps, generation, revision, events, 0)
+            .map_err(|e| e.to_string())?;
+        self.app.visual.install_batch(batch);
+        Ok(())
+    }
+    pub fn audio(
+        &mut self,
+        json: &str,
+        generation: u64,
+        sequence: u64,
+        time: f64,
+        rate: u32,
+    ) -> Result<(), String> {
+        use rustel_runtime::ui_analysis::{UiAudioAnalysisSet, UiAudioAnalyzer};
+        let values: serde_json::Value = serde_json::from_str(json).map_err(|e| e.to_string())?;
+        let samples = |value: &serde_json::Value| {
+            value
+                .as_array()
+                .map(|a| {
+                    a.iter()
+                        .filter_map(|v| v.as_f64().filter(|v| v.is_finite()).map(|v| v as f32))
+                        .take(4096)
+                        .collect::<Vec<_>>()
+                })
+                .unwrap_or_default()
+        };
+        let analyzer = &mut self.analyzer;
+        let mono = samples(&values["master"]);
+        self.app
+            .worker
+            .master()
+            .browser_peak(mono.iter().map(|s| s.abs()).fold(0.0, f32::max));
+        let master = analyzer.analyze(&mono);
+        let visuals = values["visuals"]
+            .as_array()
+            .map(|a| {
+                a.iter()
+                    .filter_map(|v| {
+                        Some((
+                            v["slot"].as_u64()? as u8,
+                            analyzer.analyze(&samples(&v["samples"])),
+                        ))
+                    })
+                    .take(64)
+                    .collect()
+            })
+            .unwrap_or_default();
+        let metadata = rustel_runtime::ui_events::UiAudioMetadata {
+            sequence,
+            generation,
+            device_time: time,
+            stream_id: 1,
+            epoch: generation,
+            end_frame: (time * rate as f64) as u64,
+            sample_rate: rate,
+        };
+        self.app.visual.install_audio(
+            metadata,
+            UiAudioAnalysisSet {
+                master,
+                visuals,
+                sides: Vec::new(),
+            },
+        );
+        Ok(())
+    }
+    pub fn render(&mut self, width: u16, height: u16) -> Result<ratatui::buffer::Buffer, String> {
+        let now = Instant::now();
+        self.app.drain_engine();
+        self.app.drain_save();
+        if self.app.prefs_pending && now.duration_since(self.app.prefs_changed_at) >= PREFS_DEBOUNCE
+        {
+            self.app.flush_prefs();
+        }
+        self.app.manifest_pending = false;
+        self.app.settle_marks(now);
+        self.app.observe_master(now);
+        self.app.advance_evaluation_flash(now);
+        self.app.expire_notice(now);
+        let mut terminal =
+            ratatui::Terminal::new(ratatui::backend::TestBackend::new(width, height))
+                .map_err(|e| e.to_string())?;
+        let mut failure = None;
+        terminal
+            .draw(|frame| {
+                if let Err(e) = self.app.paint_into(frame, now) {
+                    failure = Some(e.to_string());
+                }
+            })
+            .map_err(|e| e.to_string())?;
+        if let Some(e) = failure {
+            return Err(e);
+        }
+        let backend = terminal.backend();
+        self.cursor = backend.cursor_visible().then(|| {
+            let p = backend.cursor_position();
+            (p.x, p.y)
+        });
+        Ok(backend.buffer().clone())
+    }
+}
