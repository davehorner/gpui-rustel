+#[cfg(target_arch = "wasm32")]
+impl Clipboard for PlatformClipboard {
+    fn get_text(&mut self) -> Result<String, ClipboardError> {
+        BROWSER_READ.with(|read| read.set(true));
+        // Keep the document and its selection intact while the asynchronous
+        // browser read completes. Its text arrives as an ordinary Paste event.
+        Err(ClipboardError("Reading clipboard…".into()))
+    }
+    fn set_text(&mut self, text: String) -> Result<(), ClipboardError> {
+        BROWSER_TEXT.with(|held| *held.borrow_mut() = text.clone());
+        BROWSER_WRITE.with(|write| *write.borrow_mut() = Some(text));
+        Ok(())
+    }
+}
