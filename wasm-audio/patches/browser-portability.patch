+        true
+    }
+    pub fn browser_text() -> String {
+        BROWSER_TEXT.with(|text| text.borrow().clone())
+    }
+    pub fn take_browser_read() -> bool {
+        BROWSER_READ.with(|read| read.replace(false))
+    }
