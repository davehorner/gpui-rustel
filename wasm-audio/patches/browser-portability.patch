+#[cfg(target_arch = "wasm32")]
+struct BrowserWorker {
+    playing: std::cell::Cell<bool>,
+    commands: Receiver<EngineCommand>,
+    controls: SyncSender<StudioControlEvent>,
+    _traces: SyncSender<UiTraceBatchRequest>,
+}
+#[cfg(target_arch = "wasm32")]
+impl StudioWorker {
+    pub(crate) fn browser() -> Result<Self, EngineFailure> {
+        let (commands, input) = sync_channel(64);
+        let (output, controls) = sync_channel(CONTROL_CAPACITY);
+        let (trace_tx, traces) = sync_channel(TRACE_CAPACITY);
+        Ok(Self {
+            browser: BrowserWorker {
+                playing: std::cell::Cell::new(false),
+                commands: input,
+                controls: output,
+                _traces: trace_tx,
+            },
+            commands,
+            controls,
+            traces,
+            latest_audio: Arc::new(Mutex::new(None)),
+            stop: StudioStopHandle::browser(),
+            immediate_stop_requested: Arc::new(AtomicBool::new(false)),
+            audition_stop_requested: Arc::new(AtomicBool::new(false)),
+            master: Arc::new(StudioMasterBus::default()),
+            library: None,
+            catalogue: super::catalogue::Catalogue::new(None).map_err(|e| EngineFailure {
+                kind: "browser".into(),
+                message: e.to_string(),
+                recoverable: false,
+                playback_stopped: true,
+            })?,
+            command_epoch: Arc::new(AtomicU64::new(0)),
+            shutdown_requested: Arc::new(AtomicBool::new(false)),
+            next_recording_request: AtomicU64::new(1),
+            look_ups_sent: AtomicU64::new(0),
+            look_ups_done: Arc::new(AtomicU64::new(0)),
+            join: None,
+        })
+    }
+    pub(crate) fn browser_commands(&self) -> Vec<serde_json::Value> {
+        use serde_json::json;
+        let mut output = Vec::new();
+        while let Ok(command) = self.browser.commands.try_recv() {
+            match command {
+                EngineCommand::Evaluate { request_id, editor_revision, source, mini, rewind, .. } => output.push(json!({ "type":"evaluate", "request":request_id, "revision":editor_revision, "source":source.as_ref(), "mini":mini, "rewind":rewind })),
+                EngineCommand::Stop | EngineCommand::StopImmediate | EngineCommand::Shutdown => output.push(json!({"type":"stop"})),
+                EngineCommand::SetOrbitGain { orbit, gain } => output.push(json!({"type":"orbit-gain", "orbit":orbit,"gain":gain})),
+                EngineCommand::SetSlider { id,value,.. } => output.push(json!({"type":"slider","id":id,"value":value})),
+                EngineCommand::LookUpSamples(_,done) => {done.fetch_add(1,Ordering::Release);},
+                EngineCommand::EvaluatePrebake {request_id,scope,..} => {let _=self.browser.controls.try_send(StudioControlEvent::Prebake(PrebakeOutcome {request_id,scope,result:Err(browser_unsupported("Prebake evaluation"))}));},
+                EngineCommand::Record {request_id,..} => {let _=self.browser.controls.try_send(StudioControlEvent::Recording(RecordingOutcome {request_id:Some(request_id),result:Err(browser_unsupported("Native recording"))}));},
+                EngineCommand::RecordSample {request_id,..} => {let _=self.browser.controls.try_send(StudioControlEvent::SampleRecording(SampleRecordingOutcome {request_id,result:Err(browser_unsupported("Audio input recording"))}));},
+                EngineCommand::Audition(..)|EngineCommand::AuditionNotes(..)|EngineCommand::AuditionRun(..)|EngineCommand::PianoNoteOn {..}|EngineCommand::SetInput(Some(_))|EngineCommand::ClockIn(Some(_))|EngineCommand::ClockOut(Some(_))|EngineCommand::Link(true) => output.push(json!({"type":"unsupported","message":"This control requires a native audio or MIDI host"})),
+                _ => {},
+            }
+        }
+        if self.immediate_stop_requested.swap(false, Ordering::AcqRel) {
+            output.push(json!({"type":"stop"}));
+        }
+        output
+    }
+    pub(crate) fn browser_evaluated(
+        &self,
+        request: u64,
+        revision: u64,
+        source: &str,
+        generation: u64,
+        error: Option<String>,
+    ) {
+        let result = match error {
+            Some(message) => Err(EngineFailure {
+                kind: "evaluation".into(),
+                message,
+                recoverable: true,
+                playback_stopped: false,
+            }),
+            None => {
+                if let Ok(layout) = rustel_runtime::ui_events::visual_layout(source, generation) {
+                    let _ = self
+                        .browser
+                        .controls
+                        .try_send(StudioControlEvent::Layout(layout));
+                }
+                Ok(StudioInstall {
+                    generation,
+                    source_revision: rustel_runtime::ui_events::source_revision(source),
+                    pending_cutover: false,
+                    answered_repeat: false,
+                    held: false,
+                })
+            }
+        };
+        let _ = self
+            .browser
+            .controls
+            .try_send(StudioControlEvent::Evaluation(EvaluationOutcome {
+                request_id: request,
+                editor_revision: revision,
+                result,
+            }));
+    }
+    pub(crate) fn browser_snapshot(
+        &self,
+        playing: bool,
+        generation: u64,
+        cycle: f64,
+        cps: f64,
+        source: &str,
+    ) {
+        let snapshot = StudioSnapshot {
+            playing,
+            session_generation: generation,
+            audible_generation: playing.then_some(generation),
+            confirmed_audio_generation: playing.then_some(generation),
+            cycle,
+            cps,
+            device_time: cycle / cps.max(0.0001),
+            source_revision: Some(rustel_runtime::ui_events::source_revision(source)),
+            output_pairs: 1,
+            ..Default::default()
+        };
+        let _ = self
+            .browser
+            .controls
+            .try_send(StudioControlEvent::Snapshot(Box::new(snapshot)));
+        if self.browser.playing.replace(playing) && !playing {
+            let _ = self
+                .browser
+                .controls
+                .try_send(StudioControlEvent::Stopped(Box::new(StudioStop::idle())));
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+fn browser_unsupported(feature: &str) -> EngineFailure {
+    EngineFailure {
+        kind: "unsupported".into(),
+        message: format!("{feature} is unavailable in the browser host"),
+        recoverable: true,
+        playback_stopped: false,
+    }
+}
