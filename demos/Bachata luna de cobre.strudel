// BACHATA LUNA DE COBRE — original 48-bar arrangement
// 118 BPM, E minor. Descending requinto and a suspended turnaround.
setcpm(118/4)
const harmony = chord("<Em9 C^7 Am9 B7>").dict("ireal")
const bajo = note("<[e2 ~ b2 e3 ~ b2 d3 b2] [c2 ~ g2 c3 ~ g2 b2 g2] [a1 ~ e2 a2 ~ e2 g2 e2] [b1 ~ fs2 b2 ~ a2 fs2 ds2]>").s("sine").gain(.18).attack(.004).release(.14).lpf(780)
const nylon = harmony.voicing().s("triangle").struct("x ~ x x ~ x ~ [x x]").gain(.078).attack(.003).decay(.12).sustain(.055).release(.06).lpf(2600).pan(-.28)
const acero = harmony.voicing().s("triangle").struct("~ x ~ ~ x ~ x ~").gain(.048).attack(.002).decay(.085).sustain(.025).release(.045).hpf(750).pan(.3)
const requinto = note("<[b5 a5 g5 fs5 e5 ~ b4 e5] [g5 e5 d5 c5 b4 ~ g4 c5] [e5 g5 a5 g5 e5 c5 b4 a4] [fs5 e5 ds5 fs5 b4 ~ ds5 fs5]>").s("triangle").gain(.115).attack(.003).decay(.16).sustain(.085).release(.09).lpf(4000).room(.2).delay(.12)
const respuesta = note("<[~ ~ g5 b5 ~ a5 g5 e5] [~ ~ e5 g5 ~ e5 d5 c5] [~ ~ c5 e5 ~ g5 e5 c5] [~ ~ ds5 fs5 ~ a5 fs5 ds5]>").s("sine").gain(.065).attack(.004).decay(.2).sustain(.06).release(.14).pan(.16).room(.24)
const campana = note("<[~ b5 ~ ~ ~ e6 ~ b5] [~ g5 ~ ~ ~ c6 ~ g5] [~ e5 ~ ~ ~ a5 ~ e5] [~ fs5 ~ ~ ~ b5 ~ fs5]>").s("sine").gain(.035).attack(.002).decay(.25).sustain(0).release(.1).pan(-.1)
const guira = s("hh*8").gain(".11 .045 .14 .06 .115 .05 .17 .075").hpf(6100).pan(-.18)
const martillo = stack(s("rim ~ rim [rim rim] ~ rim rim ~").gain(.135).pan(.2), s("~ ~ ~ ~ ~ ~ cp ~").gain(.08))
const pulso = s("bd ~ ~ ~ bd ~ bd ~").gain(.15)
const colchon = harmony.voicing().s("sine").slow(2).gain(.026).attack(.3).release(.5).lpf(1500).room(.3)
const entrada = stack(nylon, acero, guira, campana)
const base = stack(bajo, nylon, acero, guira, martillo, pulso)
const verso = stack(base, requinto)
const coro = stack(base, requinto, respuesta, colchon)
const puente = stack(bajo.slow(2), acero, respuesta, guira.gain(.045), campana)
const salida = stack(bajo, nylon, acero, guira, respuesta, campana)
$: arrange([4, entrada], [8, verso], [8, coro], [4, puente], [8, coro], [8, verso], [8, salida])
