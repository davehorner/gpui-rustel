
// BACHATA DE MEDIANOCHE
// Sensual Bachata — Full Arrangement
// 124 BPM | A minor | ~3:06

setcpm(124/4)
const bpm = 124

// 1 cycle = 1 bar of 4/4
// 96 bars = approximately 3:06

// ---------------------------------
// HARMONIC PROGRESSION
// Am9 - Fmaj7 - Cmaj7 - G6
// ---------------------------------

const harmony = chord("<Am9 Fmaj7 Cmaj7 G6>")
  .dict("ireal")

// ---------------------------------
// BASS — warm, dancing, intimate
// ---------------------------------

const bass = note(
  "<[a2 ~ e3 a2 e3 ~ g2 e3] \
    [f2 ~ c3 f2 c3 ~ e2 c3] \
    [c3 ~ g3 c3 g2 ~ b2 g2] \
    [g2 ~ d3 g2 d3 ~ b2 d3]>"
)
  .s("gm_acoustic_bass")
  .gain(0.72)
  .lpf(950)
  .release(0.2)

// ---------------------------------
// GUITAR — syncopated bachata
// ---------------------------------

const rhythm = harmony
  .voicing()
  .s("gm_acoustic_guitar_nylon")
  .struct("~ x ~ x ~ x xx x")
  .decay(0.16)
  .sustain(0.12)
  .gain(0.43)
  .pan(-0.3)
  .room(0.16)

// Second guitar, lighter offbeats
const rhythm2 = harmony
  .voicing()
  .s("gm_acoustic_guitar_steel")
  .struct("~ ~ x ~ ~ ~ x ~")
  .gain(0.19)
  .pan(0.35)
  .room(0.25)

// ---------------------------------
// REQUINTO — sensual lead melody
// ---------------------------------

const leadA = note(
  "<[e5 g5 a5 ~ c6 b5 a5 g5] \
    [a5 ~ g5 f5 e5 ~ c5 e5] \
    [g5 e5 d5 c5 e5 ~ g5 e5] \
    [d5 ~ b4 d5 g5 f5 e5 d5]>"
)
  .s("gm_acoustic_guitar_steel")
  .gain(0.56)
  .room(0.38)
  .delay(0.24)
  .delaytime(0.375)
  .delayfeedback(0.22)
  .pan(0.2)

const leadB = note(
  "<[a5 c6 e6 ~ d6 c6 b5 a5] \
    [c6 ~ a5 g5 f5 a5 c6 a5] \
    [g5 c6 e6 d6 c6 ~ g5 e5] \
    [b5 a5 g5 d6 b5 g5 e5 d5]>"
)
  .s("gm_acoustic_guitar_steel")
  .gain(0.62)
  .room(0.4)
  .delay(0.3)
  .delaytime(0.375)
  .delayfeedback(0.27)

// ---------------------------------
// PERCUSSION
// ---------------------------------

const guira = s("hh*8")
  .gain("0.23 0.1 0.28 0.12 0.25 0.1 0.38 0.14")
  .hpf(6500)
  .pan(-0.22)

const bongos = stack(
  s("~ rim ~ rim ~ rim ~ rim")
    .gain(0.28),
  s("~ ~ ~ ~ ~ ~ cp ~")
    .gain(0.35),
  s("bd ~ ~ bd ~ bd ~ ~")
    .gain(0.28)
)

const pulse = stack(
  s("bd ~ ~ ~ bd ~ ~ ~").gain(0.42),
  s("~ ~ sd ~ ~ ~ sd ~").gain(0.25)
)

// ---------------------------------
// ATMOSPHERE — warm and seductive
// ---------------------------------

const keys = harmony
  .voicing()
  .s("gm_electric_piano_1")
  .struct("x ~ ~ ~ x ~ ~ ~")
  .gain(0.28)
  .room(0.5)
  .delay(0.15)

const pad = harmony
  .voicing()
  .s("gm_string_ensemble_1")
  .attack(0.5)
  .release(1.4)
  .gain(0.13)
  .room(0.65)

// ---------------------------------
// GUITAR SOLO
// ---------------------------------

const solo = note(
  "<[e5 g5 a5 c6 e6 d6 c6 a5] \
    [c6 a5 g5 f5 a5 c6 e6 c6] \
    [g5 c6 e6 g6 e6 d6 c6 g5] \
    [b5 d6 g6 d6 b5 a5 g5 d5] \
    [a5 c6 e6 a6 g6 e6 c6 a5] \
    [f5 a5 c6 f6 e6 c6 a5 g5] \
    [e5 g5 c6 e6 g6 e6 d6 c6] \
    [b5 g5 d6 b5 a5 g5 e5 d5]>"
)
  .s("gm_acoustic_guitar_steel")
  .gain(0.7)
  .room(0.48)
  .delay(0.33)
  .delaytime(0.375)
  .delayfeedback(0.3)

// ---------------------------------
// ARRANGEMENT — 96 BARS
// ---------------------------------

const arrangement = arrange(
  [8, stack(
    rhythm,
    keys,
    leadA.gain(0.35),
    pad
  )],

  [16, stack(
    bass,
    rhythm,
    rhythm2,
    guira,
    bongos,
    keys,
    leadA.gain(0.35)
  )],

  [16, stack(
    bass,
    rhythm,
    rhythm2,
    guira,
    bongos,
    pulse,
    keys,
    pad,
    leadB
  )],

  [8, stack(
    bass,
    rhythm,
    guira,
    bongos,
    keys,
    leadA.gain(0.3)
  )],

  [16, stack(
    bass,
    rhythm,
    rhythm2,
    guira,
    bongos,
    pulse,
    keys,
    pad,
    solo
  )],

  [8, stack(
    rhythm.gain(0.25),
    keys,
    pad,
    leadA.gain(0.24)
  )],

  [16, stack(
    bass,
    rhythm,
    rhythm2,
    guira,
    bongos,
    pulse,
    keys,
    pad,
    leadB,
    leadA.gain(0.2)
  )],

  [8, stack(
    bass.gain(0.4),
    rhythm,
    keys,
    pad,
    leadA.gain(0.4)
  )]
)

$: arrangement
