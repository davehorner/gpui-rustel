// SALSA BRISA DEL MALECON — original 48-bar arrangement
// 196 BPM, F major. Flute-led son, 2-3 clave and a bright piano montuno.
setcpm(196/4)
const harmony = chord("<F6 Dm9 Gm9 C7>").dict("ireal")
const tumbao = note("<[~ f2 ~ c3 ~ ~ e3 f3] [~ d2 ~ a2 ~ ~ c3 d3] [~ g1 ~ d2 ~ ~ f2 g2] [~ c2 ~ g2 ~ ~ bb2 e3]>").s("gm_acoustic_bass").gain(.46).attack(.004).release(.085).lpf(1150)
const montuno = note("<[f4 a4 c5 a4 ~ d5 c5 a4] [d4 f4 a4 f4 ~ c5 a4 f4] [g4 bb4 d5 bb4 ~ f5 d5 bb4] [c4 e4 g4 e4 ~ bb4 g4 e4]>").s("gm_acoustic_grand_piano").gain(.27).attack(.002).decay(.13).sustain(.065).release(.05).pan(-.2)
const respuestaPiano = note("<[~ c6 ~ a5 c6 ~ d6 c6] [~ a5 ~ f5 a5 ~ c6 a5] [~ d6 ~ bb5 d6 ~ f6 d6] [~ g5 ~ e5 g5 ~ bb5 g5]>").s("gm_acoustic_grand_piano").gain(.12).decay(.11).sustain(.035).release(.045).pan(.18)
const flauta = note("<[c5 f5 a5 g5 ~ f5 e5 c5] [a4 d5 f5 e5 ~ d5 c5 a4] [d5 g5 bb5 a5 ~ g5 f5 d5] [g4 c5 e5 g5 bb5 a5 g5 e5]>").s("gm_flute").gain(.30).attack(.014).release(.10).room(.18).pan(.12)
const trompeta = note("<[~ ~ a4 c5 ~ f5 e5 c5] [~ ~ f4 a4 ~ d5 c5 a4] [~ ~ bb4 d5 ~ g5 f5 d5] [~ ~ e4 g4 ~ bb4 a4 g4]>").s("gm_trumpet").gain(.22).attack(.012).release(.075).room(.14).pan(-.1)
const metales = harmony.voicing().s("gm_brass_section").struct("~ x ~ ~ x ~ [x x] ~").gain(.22).attack(.01).decay(.12).sustain(.16).release(.065)
const clave = s("<[~ ~ rim ~ rim ~ ~ ~] [rim ~ ~ rim ~ ~ rim ~]>").gain(.18).pan(.23)
const congas = stack(s("rim ~ rim ~ [rim rim] ~ rim rim").gain(".12 .06 .16 .07 .10 .06 .15 .09").speed(.72).pan(-.2),s("~ cp ~ ~ ~ cp ~ cp").gain(.065).speed(.64).pan(.12))
const cascara = s("hh*8").gain(".085 .035 .12 .05 .08 .04 .13 .055").hpf(5000).pan(.27)
const campana = note("[c6 ~ c6 ~ c6 c6 ~ c6]").s("gm_woodblock").gain(.115).decay(.075).release(.025).pan(.25)
const bombo = s("bd ~ ~ ~ ~ bd ~ ~").gain(.11)
const timbal = s("~ ~ rim ~ ~ [rim rim] cp [rim rim]").gain(.10).speed(1.3).pan(-.27)
const entrada = stack(montuno, clave, cascara, flauta.gain(.16))
const base = stack(tumbao, montuno, clave, congas, cascara, bombo)
const paseo = stack(base, flauta)
const coro = stack(base, respuestaPiano, flauta, trompeta, campana)
const mambo = stack(base, respuestaPiano, metales, trompeta, campana, timbal)
const descarga = stack(tumbao, montuno, respuestaPiano, clave, congas, campana, timbal)
const salida = stack(base, flauta, metales, timbal)
$: arrange([4, entrada], [8, paseo], [8, coro], [8, mambo], [8, descarga], [8, salida], [4, entrada])
