// BACHATA SAL Y CANELA — original 40-bar arrangement
// 124 BPM, B minor. Sampled nylon/steel guitars, acoustic bass and drum samples.
setcpm(124/4)
const harmony = chord("<Bm9 G^7 D^7 F#7>").dict("ireal")
const bajo = note("<[b1 ~ fs2 b2 ~ fs2 a2 fs2] [g1 ~ d2 g2 ~ d2 fs2 d2] [d2 ~ a2 d3 ~ a2 cs3 a2] [fs1 ~ cs2 fs2 ~ e2 cs2 as1]>").s("gm_acoustic_bass").gain(.48).attack(.004).release(.13).lpf(820)
const rasgueo = harmony.voicing().s("gm_acoustic_guitar_nylon").struct("x ~ [x x] ~ ~ x x ~").gain(.30).attack(.002).decay(.105).sustain(.05).release(.055).lpf(2900).pan(-.28)
const segunda = harmony.voicing().s("gm_acoustic_guitar_steel").struct("~ x ~ x ~ ~ x [~ x]").gain(.18).attack(.002).decay(.075).sustain(.025).release(.04).hpf(680).pan(.3)
const requinto = note("<[fs4 b4 cs5 d5 fs5 e5 d5 ~] [d5 g5 a5 b5 a5 g5 fs5 d5] [a4 d5 e5 fs5 a5 fs5 e5 cs5] [cs5 fs5 as5 gs5 fs5 e5 cs5 ~]>").s("gm_acoustic_guitar_steel").gain(.36).attack(.003).decay(.15).sustain(.075).release(.085).lpf(4400).room(.18).delay(.11)
const contestacion = note("<[~ ~ d5 cs5 ~ b4 fs4 a4] [~ ~ b4 d5 ~ g5 fs5 d5] [~ ~ fs5 e5 ~ d5 a4 cs5] [~ ~ as4 cs5 ~ e5 cs5 as4]>").s("gm_electric_piano_1").gain(.16).attack(.004).decay(.19).sustain(.055).release(.12).pan(.18).room(.22)
const brillo = note("<[~ fs6 ~ ~ ~ d6 ~ fs6] [~ d6 ~ ~ ~ b5 ~ d6] [~ a5 ~ ~ ~ fs6 ~ a5] [~ cs6 ~ ~ ~ as5 ~ cs6]>").s("sine").gain(.028).attack(.002).decay(.24).sustain(0).release(.08).pan(-.12)
const guira = s("hh*8").gain(".115 .045 .15 .06 .12 .05 .175 .075").hpf(6300).pan(-.17)
const martillo = stack(s("rim ~ rim rim ~ [rim rim] rim ~").gain(.13).pan(.18),s("~ ~ ~ ~ ~ ~ cp ~").gain(.085))
const latido = s("bd ~ ~ bd bd ~ ~ ~").gain(.145)
const nube = harmony.voicing().s("sine").slow(2).gain(.024).attack(.3).release(.5).lpf(1600).room(.3)
const entrada = stack(rasgueo, segunda, guira, brillo)
const base = stack(bajo, rasgueo, segunda, guira, martillo, latido)
const verso = stack(base, requinto)
const coro = stack(base, requinto, contestacion, nube)
const puente = stack(bajo.slow(2), segunda, contestacion, brillo, guira.gain(.045))
const cierre = stack(base, contestacion, brillo)
$: arrange([4, entrada], [8, verso], [8, coro], [4, puente], [8, coro], [8, cierre])
