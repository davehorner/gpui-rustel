// BACHATA DE FAROLES — an original 32-bar arrangement
// 122 BPM, D minor. Plucked synth guitars keep it self-contained.
setcpm(122/4)
const harmony = chord("<Dm9 Bb^7 F^7 C7>").dict("ireal")
const bass = note("<[d2 ~ a2 d3 ~ a2 c3 a2] [bb1 ~ f2 bb2 ~ f2 a2 f2] [f2 ~ c3 f3 ~ c3 e3 c3] [c2 ~ g2 c3 ~ g2 bb2 g2]>").s("sine").gain(.19).lpf(700).release(.12)
const derecho = harmony.voicing().s("triangle").struct("x ~ x x ~ x x ~").gain(.085).attack(.002).decay(.13).sustain(.08).release(.06).lpf(2800).pan(-.25)
const segunda = harmony.voicing().s("triangle").struct("~ x ~ ~ x ~ ~ [x x]").gain(.055).attack(.002).decay(.09).sustain(.04).release(.05).hpf(500).pan(.28)
const requinto = note("<[a4 d5 f5 e5 d5 ~ a4 c5] [d5 f5 a5 g5 f5 ~ e5 d5] [c5 f5 a5 g5 f5 e5 c5 a4] [g4 c5 e5 d5 c5 bb4 a4 ~]>").s("triangle").gain(.12).attack(.003).decay(.16).sustain(.12).release(.09).lpf(4200).room(.15).delay(.12)
const respuesta = note("<[~ ~ f5 e5 ~ d5 c5 a4] [~ ~ d5 f5 ~ a5 g5 f5] [~ ~ a5 g5 ~ f5 e5 c5] [~ ~ g5 e5 ~ d5 c5 ~]>").s("sine").gain(.075).attack(.004).decay(.18).sustain(.08).release(.1).pan(.18)
const guira = s("hh*8").gain(".12 .055 .14 .065 .12 .055 .18 .08").hpf(6000).pan(-.18)
const martillo = stack(s("rim ~ rim rim ~ rim rim ~").gain(.16).pan(.15), s("~ ~ ~ ~ ~ ~ cp ~").gain(.10))
const pulso = s("bd ~ ~ ~ bd ~ ~ bd").gain(.16)
const intro = stack(derecho, segunda, guira)
const verso = stack(bass, derecho, segunda, guira, martillo, pulso, requinto)
const coro = stack(bass, derecho, segunda, guira, martillo, pulso, requinto, respuesta)
const puente = stack(bass, segunda, guira.gain(.06), respuesta)
const final = stack(bass, derecho, segunda, guira, martillo, pulso, requinto, respuesta)
$: arrange([4, intro], [8, verso], [8, coro], [4, puente], [8, final])
