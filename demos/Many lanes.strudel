// Nine interacting lanes; built-in synths only, no sample downloads.
// Every lane stays a separate $: source for Bespoke and both viewers.

// 1. Arpeggio: nested subdivisions, alternate endings, periodic reversal.
$: note("c3 [e3 g3] b3 <d4 a3>")
  .s("sine").gain(0.065).scope()
  .every(4, x => x.rev()).sometimes(x => x.fast(2))
  .pan(sine.range(-0.6, 0.6).slow(8))

// 2. Euclidean bass: five hits distributed across eight steps.
$: note("<c2 a1 f2 g2>").euclid(5, 8)
  .s("triangle").gain(0.055).decay(0.16)
  .every(4, x => x.fast(2))

// 3. Long anchor: weighted time and a four-cycle harmonic movement.
$: note("<c2@2 a1 f2 g2>").slow(4)
  .s("sine").gain(0.045)

// 4. Three simultaneous voices; each follows its own alternating phrase.
$: stack(
    note("<c4 a3 f4 g3>"),
    note("<e4 c4 a4 b3>"),
    note("<g4 e4 c5 d4>")
  ).slow(2).s("triangle").gain(0.022)
  .pan("<-0.35 0.35>")

// 5. A palindrome with a quieter, delayed fifth above each phrase.
$: note("c5 [e5 g5] ~ [b4 d5]").palindrome()
  .s("sine").gain(0.028).decay(0.18)
  .off(1/8, x => x.transpose(7).gain(0.012))

// 6. Polymeter: three-note and five-note phrases drift against each other.
$: polymeter("c5 e5 g5", "g4 b4 d5 e5 a5").note()
  .s("sine").gain(0.018).decay(0.12).slow(2)

// 7. A separate rhythmic mask, with a denser fill every third cycle.
$: note("<c4 g4 e4 b4>").struct("x ~ [x x] ~ x ~ ~ x")
  .s("triangle").gain(0.03).decay(0.07)
  .every(3, x => x.fast(2))

// 8. High ticks: probabilistic gaps and patterned accents.
$: note("c6*16").degradeBy(0.4)
  .s("sine").gain("0.008 0.003 0.005 0.003").decay(0.025)
  .pan("<-0.65 0.65>")

// 9. Stereo counterpoint: reverse one side, occasionally jump an octave.
$: note("c4 ~ e4 g4 ~ b4 a4 ~")
  .s("triangle").gain(0.018).decay(0.2).slow(2)
  .jux(rev).sometimes(x => x.transpose(12))
//hush()