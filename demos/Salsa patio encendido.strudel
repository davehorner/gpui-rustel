// SALSA PATIO ENCENDIDO — original 48-bar arrangement
// 188 BPM, C minor. Piano montuno, anticipated bass and 3-2 son clave.
setcpm(188/4)
const harmony = chord("<Cm9 Fm9 Dm7b5 G7>").dict("ireal")
const tumbao = note("<[~ c2 ~ g2 ~ ~ bb2 c3] [~ f2 ~ c3 ~ ~ eb3 f3] [~ d2 ~ ab2 ~ ~ c3 d3] [~ g1 ~ d2 ~ ~ f2 b2]>").s("gm_acoustic_bass").gain(.47).attack(.004).release(.09).lpf(1100)
const montuno = note("<[c4 g4 eb5 g4 ~ bb4 eb5 g4] [f4 c5 ab5 c5 ~ eb5 ab5 c5] [d4 ab4 f5 ab4 ~ c5 f5 ab4] [g3 d4 b4 d4 ~ f4 b4 d4]>").s("gm_acoustic_grand_piano").gain(.28).decay(.14).sustain(.08).release(.065).pan(-.18)
const pianoAlto = note("<[~ ~ g5 ~ bb5 g5 ~ eb5] [~ ~ c6 ~ eb6 c6 ~ ab5] [~ ~ ab5 ~ c6 ab5 ~ f5] [~ ~ d5 ~ f5 d5 ~ b4]>").s("gm_acoustic_grand_piano").gain(.14).decay(.12).sustain(.04).release(.05).pan(.16)
const metales = harmony.voicing().s("gm_brass_section").struct("~ ~ x ~ ~ x ~ [x ~]").gain(.24).attack(.012).decay(.15).sustain(.2).release(.08).room(.13)
const pregon = note("<[g4 ~ c5 eb5 ~ d5 c5 ~] [ab4 ~ c5 f5 ~ eb5 c5 ab4] [f4 ~ ab4 c5 ~ d5 f5 ~] [d5 b4 g4 ~ f5 d5 b4 g4]>").s("gm_trumpet").gain(.27).attack(.012).release(.08).pan(.13).room(.16)
const respuesta = note("<[~ ~ eb5 g5 ~ eb5 d5 c5] [~ ~ ab5 c6 ~ ab5 g5 f5] [~ ~ f5 ab5 ~ f5 eb5 d5] [~ ~ b4 d5 ~ f5 d5 b4]>").s("gm_trombone").gain(.18).attack(.015).release(.09).pan(-.12)
const clave = s("<[rim ~ ~ rim ~ ~ rim ~] [~ ~ rim ~ rim ~ ~ ~]>").gain(.19).pan(.22)
const congas = stack(s("rim ~ rim rim ~ rim [rim rim] ~").gain(".10 .06 .15 .085 .07 .14 .10 .06").speed(.7).pan(-.2),s("~ ~ cp ~ ~ cp ~ cp").gain(.065).speed(.65).pan(.12))
const cascara = s("hh*8").gain(".08 .04 .11 .055 .075 .045 .12 .06").hpf(4800).pan(.3)
const campana = note("[c6 ~ c6 c6 ~ c6 ~ c6]").s("gm_woodblock").gain(.12).decay(.08).release(.03).pan(.25)
const bombo = s("bd ~ ~ ~ ~ ~ bd ~").gain(.12)
const timbales = s("~ ~ ~ ~ rim [rim rim] rim [cp rim]").gain(.10).speed(1.35).pan(-.28)
const entrada = stack(montuno, clave, cascara)
const base = stack(tumbao, montuno, clave, congas, cascara, bombo)
const verso = stack(base, pregon)
const mambo = stack(base, pianoAlto, metales, respuesta, campana)
const descarga = stack(tumbao, montuno, pianoAlto, clave, congas, campana, timbales)
const cierre = stack(base, metales, pregon, respuesta, campana, timbales)
$: arrange([4, entrada], [8, verso], [8, mambo], [8, descarga], [8, verso], [8, cierre], [4, entrada])
