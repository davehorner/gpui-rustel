// BACHATA DE LA BRISA — original 40-bar arrangement
// 126 BPM, A minor. Bright requinto, offbeat plucks and a half-time bridge.
setcpm(126/4)
const harmony = chord("<Am9 G6 F^7 E7>").dict("ireal")
const bajo = note("<[a1 ~ e2 a2 ~ e2 g2 e2] [g1 ~ d2 g2 ~ d2 f2 d2] [f1 ~ c2 f2 ~ c2 e2 c2] [e1 ~ b1 e2 ~ b1 d2 gs2]>").s("sine").gain(.18).attack(.003).release(.12).lpf(850)
const guitarra = harmony.voicing().s("triangle").struct("x ~ x ~ ~ x [x x] ~").gain(.08).attack(.002).decay(.11).sustain(.06).release(.055).lpf(3100).pan(-.3)
const contra = harmony.voicing().s("triangle").struct("~ x ~ x ~ ~ x [~ x]").gain(.05).attack(.002).decay(.08).sustain(.03).release(.04).hpf(650).pan(.3)
const requinto = note("<[e5 a5 b5 c6 b5 a5 e5 ~] [d5 g5 a5 b5 a5 g5 d5 ~] [c5 f5 g5 a5 g5 f5 e5 c5] [b4 e5 gs5 b5 a5 gs5 e5 ~]>").s("triangle").gain(.115).attack(.003).decay(.14).sustain(.09).release(.08).lpf(4600).room(.18).delay(.12)
const eco = note("<[~ e5 ~ c5 ~ b4 c5 e5] [~ d5 ~ b4 ~ a4 b4 d5] [~ c5 ~ a4 ~ g4 a4 c5] [~ b4 ~ gs4 ~ b4 e5 gs5]>").s("sine").gain(.065).decay(.18).sustain(.07).release(.12).pan(.2).room(.2)
const guira = s("hh*8").gain(".12 .05 .15 .055 .11 .05 .18 .075").hpf(6200).pan(-.15)
const bongo = stack(s("rim ~ rim rim ~ rim ~ [rim rim]").gain(.14).pan(.18), s("~ ~ ~ ~ ~ ~ cp ~").gain(.085))
const pulso = s("bd ~ ~ bd bd ~ ~ ~").gain(.145)
const aire = harmony.voicing().s("sine").slow(2).gain(.028).attack(.25).release(.45).lpf(1700).room(.3)
const entrada = stack(guitarra, contra, guira)
const paseo = stack(bajo, guitarra, contra, guira, bongo, pulso)
const canto = stack(paseo, requinto)
const vuelta = stack(paseo, requinto, eco, aire)
const respiro = stack(bajo.slow(2), contra, guira.gain(.055), eco, aire)
const despedida = stack(guitarra, contra, bajo, eco, guira)
$: arrange([4, entrada], [8, canto], [8, vuelta], [4, respiro], [8, vuelta], [8, despedida])
