+/// Thread-safe host tools served through the existing native MCP endpoint.
+#[cfg(not(target_arch = "wasm32"))]
+#[derive(Clone)]
+pub struct McpExtension {
+    pub tools: Vec<serde_json::Value>,
+    pub call: std::sync::Arc<dyn Fn(&str, serde_json::Value) -> Result<serde_json::Value, String> + Send + Sync>,
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub fn set_mcp_extension(world: &World, extension: McpExtension) {
+    let channel = world.res::<crate::resources::AgentChannel>();
+    *channel.extension.lock().unwrap() = Some(extension);
+}
